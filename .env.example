# Copie para .env e preencha. O arquivo .env NÃO vai para o Git.
# No perfil dev, todas são opcionais. No perfil prod (nuvem), as marcadas com * são obrigatórias.

# --- Perfil ---
SPRING_PROFILES_ACTIVE=dev
ZELA_AMBIENTE=local

# --- Banco (prod) ---
# *DB_URL=
# *DB_USER=
# *DB_PASSWORD=

# --- JWT ---
# *Segredo com pelo menos 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACAO_HORAS=8

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- IA (Gemini) ---
# none = IA simulada (sem custo) · google-genai = Gemini de verdade
IA_PROVEDOR=none
GEMINI_API_KEY=
IA_MODELO=gemini-2.5-flash
