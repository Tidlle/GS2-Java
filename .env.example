# Copie para .env e preencha. O arquivo .env NÃO vai para o Git.
# A API lê o .env sozinha (mvnw e java -jar rodando na pasta do projeto) e o docker-compose também.
# No perfil dev, todas são opcionais. No perfil prod (nuvem), as marcadas com * são obrigatórias.

# --- Perfil ---
SPRING_PROFILES_ACTIVE=dev
ZELA_AMBIENTE=local

# --- Banco (prod) ---
# *DB_URL=
# *DB_USER=
# *DB_PASSWORD=

# --- JWT ---
# *Segredo com pelo menos 32 caracteres. Gere um com: openssl rand -base64 48
# Em dev pode ficar comentado (usa um segredo local). Não deixe "JWT_SECRET=" vazio: vazio impede a API de subir.
# JWT_SECRET=
JWT_EXPIRACAO_HORAS=8

# --- CORS (app Expo na web) ---
CORS_ORIGENS=*

# --- RabbitMQ ---
# rabbitmq (padrão) ou local (sem broker: eventos processados no mesmo processo)
MENSAGERIA_MODO=rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- IA (Gemini) ---
# none = IA simulada (sem custo) · google-genai = Gemini de verdade
IA_PROVEDOR=none
GEMINI_API_KEY=
IA_MODELO=gemini-2.5-flash

# --- Fotos ---
FOTOS_DIRETORIO=uploads

# --- Prazos ---
AGENDAMENTO_HABILITADO=true
# Intervalo entre verificações (PT5M = 5 minutos; na demo, PT1M)
AGENDAMENTO_INTERVALO=PT5M
